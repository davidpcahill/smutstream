# Copy to .env and fill in. .env is gitignored.

# --- e621 credentials (required for full access + sane rate limits) ---
# Create an API key at https://e621.net/users/home -> Manage API Access
E621_USERNAME=your_username_here
E621_API_KEY=your_api_key_here

# --- App ---
PORT=3000
BIND_HOST=0.0.0.0
# Port advertised in the overlay / QR code. In `npm run dev` this is 5173 (Vite)
# because the React UI is only served through Vite in dev. In production
# (`npm run build && npm start`) leave unset so it matches PORT.
# PUBLIC_PORT=3000

# Comma-separated tags ALWAYS prepended as negatives to every search.
# Keep your party rules here. Edit as you see fit.
SAFETY_BLACKLIST=young,loli,shota,cub,gore,scat,vore

# --- Slideshow tuning (defaults for new installs; the control panel overrides these) ---
# How long each image is shown, in seconds.
SLIDE_DURATION_SECONDS=60
# How long the crossfade between images lasts, in seconds.
SLIDE_FADE_SECONDS=2
# How often the LAN-info overlay appears (seconds between shows).
OVERLAY_INTERVAL_SECONDS=360
# How long it lingers each time.
OVERLAY_DURATION_SECONDS=45

# --- Cache ---
# Where to store downloaded images.
CACHE_DIR=./cache
# Sweep older files after this many hours.
CACHE_TTL_HOURS=12
